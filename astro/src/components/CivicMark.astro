---
// Abstract civic mark — angular, generic; two stacked diamonds in a hex
// frame. Not the state seal. Verbatim geometry from the demo's CivicMark.
interface Props {
  size?: number;
  stroke?: number;
  class?: string;
}
const { size = 26, stroke = 1.4, class: className } = Astro.props;
---
<svg
  width={size}
  height={size}
  viewBox="0 0 40 40"
  fill="none"
  stroke="currentColor"
  stroke-width={stroke}
  stroke-linejoin="miter"
  aria-hidden="true"
  class={className}
  style="display:block"
>
  <polygon points="20,2 36,11 36,29 20,38 4,29 4,11"></polygon>
  <polygon points="20,9 30,15 20,21 10,15"></polygon>
  <polygon points="20,19 30,25 20,31 10,25"></polygon>
  <line x1="20" y1="2" x2="20" y2="38"></line>
</svg>
