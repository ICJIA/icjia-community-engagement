---
// §E — dummy subscribe form. Submission is prevented client-side (Alpine
// `subscribe` component) so there's no navigation and no backend needed yet.
---
<section
  id="subscribe"
  class="relative isolate mx-auto max-w-[1320px] scroll-mt-24 border-t border-transparent px-5 py-14 before:absolute before:inset-y-0 before:left-1/2 before:-z-10 before:w-screen before:-translate-x-1/2 before:bg-[color-mix(in_oklch,var(--color-accent)_7%,var(--color-surface))] before:content-[''] sm:px-8 lg:px-14 lg:py-18"
>
  <div class="grid grid-cols-1 items-start gap-10 md:grid-cols-2 lg:gap-20">
    <div>
      <span class="mb-3 block font-mono text-[11px] tracking-[0.1em] text-accent-fg uppercase">§ E · Stay connected</span>
      <h2 class="m-0 max-w-[24ch] text-[40px] leading-[1.05] font-medium tracking-[-0.025em] text-balance">
        Engagement Brief — quarterly, by email.
      </h2>
      <p class="mt-4 max-w-[50ch] text-[14px] leading-[1.5] text-dim">
        Announcements, event invitations, surveys, and public safety resource updates.
        Quarterly digest · used only for ICJIA Community Engagement.
      </p>
    </div>

    <form x-data="subscribe" x-on:submit.prevent="submit" class="grid gap-3" novalidate>
      <label for="subscribe-email" class="mono text-dim">Email address</label>
      <div class="grid grid-cols-[1fr_auto] gap-2">
        <input
          id="subscribe-email"
          type="email"
          name="email"
          placeholder="you@illinois.gov"
          autocomplete="email"
          class="rounded-[2px] border border-line bg-surface px-4 py-3.5 text-[15px] text-fg outline-none transition-[border-color,background-color] placeholder:text-mute focus:border-accent focus:bg-bg"
        />
        <button
          type="submit"
          class="cursor-pointer rounded-[2px] border-0 bg-accent px-5 text-[14px] font-medium whitespace-nowrap text-accent-on transition-colors hover:bg-accent-hover focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
        >
          Subscribe →
        </button>
      </div>
      <div class="flex items-baseline gap-2">
        <span class="mono text-dim">Subscribers</span>
        <span class="font-mono text-[16px] tracking-[0.06em] text-fg">8,420</span>
        <span class="mono text-dim">· delivered quarterly</span>
      </div>
    </form>
  </div>
</section>
