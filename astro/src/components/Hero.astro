---
import { SITE } from '../data/content';
---
<section class="mx-auto max-w-[1320px] px-5 pt-14 pb-12 sm:px-8 lg:px-14 lg:pt-18 lg:pb-16">
  <h1 class="m-0 text-[clamp(52px,6.4vw,92px)] leading-[0.98] font-medium tracking-[-0.035em] text-balance">
    Connecting communities,<br />
    partners, and public safety<br />
    resources across <em class="text-accent-fg not-italic">Illinois.</em>
  </h1>

  <div class="mt-14 grid grid-cols-1 items-start gap-10 border-t border-line pt-7 lg:grid-cols-[1.6fr_1fr] lg:gap-16">
    <p class="m-0 max-w-[60ch] text-lg leading-normal text-fg">{SITE.blurb}</p>

    <div class="flex flex-col items-start gap-3">
      <a
        href="#events"
        class="group inline-flex items-center gap-2.5 border-b border-line pb-1 text-[15px] text-fg no-underline transition-[color,border-color,gap] duration-150 hover:gap-3.5 hover:border-accent hover:text-accent-fg"
      >
        View upcoming events
        <span class="inline-block transition-transform duration-200 group-hover:translate-x-0.5">→</span>
      </a>
      <a
        href="#subscribe"
        class="group inline-flex items-center gap-2.5 border-b border-line pb-1 text-[15px] text-dim no-underline transition-[color,border-color,gap] duration-150 hover:gap-3.5 hover:border-accent hover:text-accent-fg"
      >
        Subscribe for updates
        <span class="inline-block transition-transform duration-200 group-hover:translate-x-0.5">→</span>
      </a>
    </div>
  </div>
</section>
