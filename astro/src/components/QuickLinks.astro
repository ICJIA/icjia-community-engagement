---
import { QUICK_LINKS } from '../data/content';
import SectionHeader from './SectionHeader.astro';

// Column dividers + edge-aligned padding (md+), matching the demo's editorial
// 3-up grid. Mobile stacks with row dividers.
const hpad = ['md:pr-7', 'md:px-7', 'md:pl-7'];
const rdiv = ['md:border-r md:border-line', 'md:border-r md:border-line', ''];
---
<section class="mx-auto max-w-[1320px] border-t border-line px-5 py-14 sm:px-8 lg:px-14 lg:py-18">
  <SectionHeader number="01" label="§ A · Start here" heading="Start here." stat={`${QUICK_LINKS.length} quick links`} />

  <div class="grid grid-cols-1 border-t border-line md:grid-cols-3">
    {
      QUICK_LINKS.map((q, i) => (
        <a
          href={q.href}
          class:list={[
            'group flex min-h-[200px] flex-col gap-3.5 border-b border-line py-7 text-inherit no-underline transition-colors last:border-b-0 hover:bg-surface md:min-h-[240px] md:border-b-0 md:py-0 md:pt-9 md:pb-7',
            hpad[i],
            rdiv[i],
          ]}
        >
          <div class="font-mono text-[12px] tracking-[0.1em] text-accent-fg uppercase">{q.no}</div>
          <div class="text-[26px] leading-[1.1] font-medium tracking-[-0.02em]">{q.title}</div>
          <div class="max-w-[36ch] text-[15px] text-dim">{q.body}</div>
          <div class="mt-auto flex items-center justify-between">
            <span class="mono text-dim">{q.stat}</span>
            <span class="text-[22px] text-dim transition-[transform,color] duration-200 group-hover:translate-x-1 group-hover:text-accent-fg">→</span>
          </div>
        </a>
      ))
    }
  </div>
</section>
